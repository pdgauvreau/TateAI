# Supabase — safe to expose to the browser.
# The anon key is designed to be public; row-level security is what protects your data.
# Find both at: Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets go here WITHOUT the VITE_ prefix so Vite never bundles them
# into client code. These are read by serverless functions in /api.
# Which adapter under api/_lib/ai/ handles chat. Defaults to anthropic.
AI_PROVIDER=anthropic

# Required for the anthropic adapter. Server-only — never give this a VITE_ prefix,
# or it would be bundled into the browser where anyone could read and spend it.
ANTHROPIC_API_KEY=

# Optional overrides for the anthropic adapter.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium
